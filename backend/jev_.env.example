# Real Gemini + Voyage adapters, both rerankers on (Voyage and Jev).
AI_PROVIDER=real
GEMINI_API_KEY=
VOYAGE_API_KEY=
JEV_API_KEY=

RERANK_ENABLED=true
RERANK_MODEL=rerank-2.5
RERANK_CANDIDATES=20
RERANK_CACHE_SIZE=2000
JEV_MODEL=jev-latest
JEV_PARALLEL_CALLS=50
DEFAULT_RERANKER=voyage

AI_CACHE_DIR=./recordings
DEMO_MODE=true

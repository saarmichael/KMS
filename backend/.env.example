# Copy to backend/.env. Never commit .env.

# Postgres. Local compose: user/password/db are all "kms"; a second db "kms_test" is created for tests.
DATABASE_URL=postgresql+psycopg://kms:kms@localhost:5432/kms
TEST_DATABASE_URL=postgresql+psycopg://kms:kms@localhost:5432/kms_test

# Each AI role names its provider; "fake" is a deterministic adapter that needs no key and costs no quota.
# Vision: "fake" or "gemini" (needs GEMINI_API_KEY). Embedding: "fake" or "voyage" (needs VOYAGE_API_KEY).
VISION_PROVIDER=fake
EMBEDDING_PROVIDER=fake
GEMINI_API_KEY=
VOYAGE_API_KEY=
# Vision models tried in order when one is overloaded, as a JSON list of VISION_PROVIDER's models;
# unset uses the default list (Gemini's).
# VISION_MODELS=["gemini-3-flash-preview", "gemini-3.1-flash-lite-preview", "gemini-3.1-flash-lite", "gemini-3.5-flash-lite"]
# Voyage calls one embed sends at once, each a batch of up to 100 inputs.
EMBED_PARALLEL_CALLS=20
# Reranker: "none" or "voyage" (needs VOYAGE_API_KEY, whatever the embedder). It scores the top search
# results against the query; with "none", no result gets a relevance. RERANK_MODEL names a model of
# RERANK_PROVIDER. RERANK_CANDIDATES results are scored; RERANK_CACHE_SIZE scores are kept.
RERANK_PROVIDER=none
RERANK_MODEL=rerank-2.5
RERANK_CANDIDATES=20
RERANK_CACHE_SIZE=2000
# Real answers are recorded here and replayed for the same request; empty turns recording off.
AI_CACHE_DIR=./recordings

# Worker: thread pool size; set WORKER_ENABLED=false to run the API alone.
WORKER_ENABLED=true
WORKER_THREADS=4

# Where file bytes are kept: "local", a folder on disk (the only store today).
BLOB_STORE=local
# The local store's folder (a Railway volume at /data in production).
BLOB_DIR=./data/blobs

# Ingest seed/<collection>/ folders on startup (on for the deployed demo, off locally).
SEED_ON_START=false

# The one password for the whole app, asked by the browser (any username); empty leaves it open.
# Set on the deployed app; change it to lock out everyone who had the old one.
APP_PASSWORD=

# A shared demo: the UI greys out deleting a collection and the API refuses it.
# On for the deployed demo, off locally.
DEMO_MODE=false
